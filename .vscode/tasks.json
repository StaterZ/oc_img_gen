{
	"version": "2.0.0",
	"tasks": [
		{
			// Program arguments and features live in settings.json.
			"type": "shell",
			"command": "cargo run --features=${config:oc_img_gen.features} -- ${config:oc_img_gen.args}",
			"problemMatcher": [
				"$rustc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"options": {
				"shell": {
					"executable": "cmd.exe",
					"args": ["/d", "/c"]
				},
				"env": {
					"RUST_BACKTRACE": "1"
				}
			},
			"label": "rust: cargo run",
			"presentation": {
				"clear": true
			}
		}
	]
}
